#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <zmk-helpers/key-labels/42.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer numbers are part of the persisted ZMK keymap state. */
#define L_BASE 0
#define L_NAV 1
#define L_MOUSE 2
#define L_MEDIA 3
#define L_NUM 4
#define L_SYM 5
#define L_FUN 6
#define L_HOST 7
#define L_GAME 8
#define L_ADJUST 9
#define L_GAME_FN 10

&sk {
    release-after-ms = <1000>;
    quick-release;
    lazy;
    ignore-modifiers;
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&lt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
    quick-tap-ms = <180>;
};

/ {
    behaviors {
        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                KEYS_R
                THUMBS_R
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                KEYS_L
                THUMBS_L
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
        /*
         * Dedicated HOST thumb layer-tap. Deliberately no quick-tap or
         * require-prior-idle: HOST must engage reliably immediately after
         * ordinary typing.
         */
        host_lt: host_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        /*
         * Dedicated GAME Esc/FN hold-tap for fast left-hand chord resolution
         * during gaming (e.g. hold Esc + Q/W/E/R/T for 1-5).
         */
        game_fn_lt: game_fn_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <L_NAV L_NUM>;
            then-layer = <L_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            display-name = "BASE";
            /* Colemak-DH, symmetric HRM, thumb layer-taps, and LM5 momentary MEDIA. */
            bindings = <
                &kp ESCAPE       &kp Q              &kp W              &kp F              &kp P              &kp B
                &kp J            &kp L              &kp U              &kp Y              &kp SQT            &kp BACKSPACE
                &mo L_MEDIA      &hml LMETA A       &hml LEFT_ALT R     &hml LCTRL S        &hml LEFT_SHIFT T   &kp G
                &kp M            &hmr RIGHT_SHIFT N &hmr RCTRL E        &hmr RIGHT_ALT I    &hmr RIGHT_GUI O   &kp SEMICOLON
                &sk LSHFT        &kp Z              &kp X              &kp C              &kp D              &kp V
                &kp K            &kp H              &kp COMMA           &kp DOT            &kp SLASH          &kp RIGHT_SHIFT
                &lt L_MOUSE ESCAPE &lt L_NAV SPACE   &host_lt L_HOST TAB &lt L_SYM ENTER     &lt L_NUM BACKSPACE &lt L_FUN DELETE
            >;
        };

        NAV {
            label = "NAV";
            display-name = "NAV";
            /*
             * Right-hand navigation mirrors MOUSE and MEDIA. Functional-layer
             * thumbs are explicit so BASE layer-taps do not leak into repeats.
             * LT5 provides a same-side left bootloader shortcut while holding NAV.
             * Caps Word is bound on RM0; semantic F21-F24 editing signals are
             * interpreted by host bridges.
             */
            bindings = <
                &bootloader      &none             &none             &none             &none             &none
                &kp LS(F24)      &kp F22           &kp F21           &kp F23           &kp F24           &none
                &none            &kp LGUI          &kp LALT          &kp LCTRL         &kp LEFT_SHIFT    &none
                &caps_word       &kp LEFT          &kp DOWN_ARROW     &kp UP_ARROW      &kp RIGHT         &none
                &none            &none             &none             &none             &none             &none
                &kp INSERT       &kp HOME          &kp PAGE_DOWN     &kp PAGE_UP       &kp END           &none
                &kp ESCAPE       &kp SPACE        &kp TAB            &kp ENTER         &kp BACKSPACE     &kp DELETE
            >;
        };


        MOUSE {
            label = "MOUSE";
            display-name = "MOUSE";
            /* NAV geometry: pointer on home, wheel on the secondary bank, F21-F24 editing. */
            bindings = <
                &none            &none             &none             &none             &none             &none
                &kp LS(F24)      &kp F22           &kp F21           &kp F23           &kp F24           &none
                &none            &kp LGUI          &kp LALT          &kp LCTRL         &kp LEFT_SHIFT    &none
                &mkp MB4         &mmv MOVE_LEFT    &mmv MOVE_DOWN     &mmv MOVE_UP      &mmv MOVE_RIGHT   &mkp MB5
                &none            &none             &none             &none             &none             &none
                &none            &msc SCRL_LEFT    &msc SCRL_DOWN     &msc SCRL_UP      &msc SCRL_RIGHT   &none
                &none            &none             &none             &mkp MB2          &mkp MB1          &mkp MB3
            >;
        };


        MEDIA {
            label = "MEDIA";
            display-name = "MEDIA";
            /* Directional media controls share NAV's right-hand geometry using Consumer HID. */
            bindings = <
                &none            &none             &none             &none             &none             &none
                &none            &none             &none             &none             &none             &none
                &none            &kp LGUI          &kp LALT          &kp LCTRL         &kp LEFT_SHIFT    &none
                &none            &kp C_PREVIOUS    &kp C_VOLUME_DOWN &kp C_VOLUME_UP   &kp C_NEXT        &none
                &none            &none             &none             &none             &none             &none
                &none            &none             &none             &none             &none             &none
                &none            &none             &none             &kp C_STOP        &kp C_PLAY_PAUSE  &kp C_MUTE
            >;
        };

        NUM {
            label = "NUM";
            display-name = "NUM";
            /*
             * Standard numpad geometry on the left; mirrored mods on the right.
             * RT5 provides a same-side right bootloader shortcut while holding NUM.
             */
            bindings = <
                &none            &kp LEFT_BRACKET  &kp NUMBER_7        &kp NUMBER_8        &kp NUMBER_9        &kp RIGHT_BRACKET
                &none            &none             &none               &none               &none               &bootloader
                &none            &kp SEMICOLON     &kp NUMBER_4        &kp NUMBER_5        &kp NUMBER_6        &kp EQUAL
                &none            &kp RIGHT_SHIFT   &kp RCTRL            &kp RIGHT_ALT       &kp RIGHT_GUI      &none
                &none            &kp GRAVE         &kp NUMBER_1        &kp NUMBER_2        &kp NUMBER_3        &kp BACKSLASH
                &none            &none             &none               &none               &none               &none
                &kp PERIOD       &kp NUMBER_0     &kp MINUS            &none               &none               &none
            >;
        };

        SYM {
            label = "SYM";
            display-name = "SYM";
            /* Shifted NUM geometry; direct programming symbols on the thumbs. */
            bindings = <
                &none            &kp LEFT_BRACE    &kp AMPERSAND        &kp ASTERISK        &kp LEFT_PARENTHESIS &kp RIGHT_BRACE
                &none            &none             &none                &none               &none                &none
                &none            &kp COLON         &kp DOLLAR           &kp PERCENT         &kp CARET            &kp PLUS
                &none            &kp RIGHT_SHIFT   &kp RCTRL             &kp RIGHT_ALT       &kp RIGHT_GUI       &none
                &none            &kp TILDE         &kp EXCLAMATION       &kp AT_SIGN         &kp HASH             &kp PIPE
                &none            &none             &none                &none               &none                &none
                &kp LEFT_PARENTHESIS &kp RIGHT_PARENTHESIS &kp UNDERSCORE &none             &none                &none
            >;
        };

        FUN {
            label = "FUN";
            display-name = "FUN";
            /* F-key geometry mirrors NUM; the right hand remains modifiers. */
            bindings = <
                &none            &kp F12            &kp F7              &kp F8              &kp F9              &kp PRINTSCREEN
                &kp CAPSLOCK     &none              &none               &none              &none              &none
                &none            &kp F11            &kp F4              &kp F5              &kp F6              &kp SCROLLLOCK
                &none            &kp RIGHT_SHIFT   &kp RCTRL            &kp RIGHT_ALT       &kp RIGHT_GUI     &none
                &none            &kp F10            &kp F1              &kp F2              &kp F3              &kp PAUSE_BREAK
                &none            &none              &none               &none              &none              &none
                &kp K_APP         &kp SPACE         &kp TAB              &none              &none              &none
            >;
        };

        HOST {
            label = "HOST";
            display-name = "HOST";
            /*
             * Semantic F-key protocol arranged by frequency: home row visits
             * workspaces, top row mirrors it one row up to move a window
             * there. Left bottom row holds system and terminal launchers.
             * Right home row has Previous Window and directional focus;
             * right bottom row has directional move. Right top row has
             * modal controls (Resize, Service) and Esc. Right thumbs carry
             * context actions (Fullscreen, Previous WS, Float).
             */
            bindings = <
                &none            &kp LS(F13)      &kp LS(F14)      &kp LS(F15)      &kp LS(F16)      &kp LS(F17)
                &none            &kp LS(F18)      &kp LA(F18)      &none            &none            &kp ESCAPE
                &none            &kp F13          &kp F14          &kp F15          &kp F16          &kp F17
                &kp LA(F16)      &kp LC(F13)      &kp LC(F14)      &kp LC(F15)      &kp LC(F16)      &none
                &none            &kp LA(F13)      &kp LA(F14)      &kp LA(F15)      &kp LA(F17)      &none
                &none            &kp LC(LS(F13))  &kp LC(LS(F14))  &kp LC(LS(F15))  &kp LC(LS(F16))  &none
                &none            &none            &none            &kp F19          &kp F18          &kp F20
            >;
        };
        GAME {
            label = "GAME";
            display-name = "GAME";
            /*
             * Plain tap-only QWERTY for gaming with hold-tap Esc/FN on LT5,
             * momentary GAME_FN on RH1, and protected BASE exit on GAME_FN RH2.
             */
            bindings = <
                &game_fn_lt L_GAME_FN ESCAPE &kp Q              &kp W              &kp E              &kp R              &kp T
                &kp Y            &kp U              &kp I              &kp O              &kp P              &kp BACKSPACE
                &kp TAB          &kp A              &kp S              &kp D              &kp F              &kp G
                &kp H            &kp J              &kp K              &kp L              &kp SEMICOLON      &kp ENTER
                &kp LEFT_SHIFT   &kp Z              &kp X              &kp C              &kp V              &kp B
                &kp N            &kp M              &kp COMMA           &kp DOT            &kp SLASH          &kp RIGHT_SHIFT
                &kp LCTRL        &kp SPACE          &kp LALT            &kp ENTER         &mo L_GAME_FN      &trans
            >;
        };

        ADJUST {
            label = "ADJUST";
            display-name = "ADJUST";
            /*
             * NAV + NUM only. Device management is explicit and source-local.
             * GAME is entered here deliberately, not from ordinary NAV keys.
             */
            bindings = <
                &bootloader       &sys_reset         &bt BT_CLR          &out OUT_USB        &out OUT_BLE        &ext_power EP_ON
                &ext_power EP_OFF  &bt BT_NXT         &bt BT_PRV          &to L_GAME          &sys_reset          &bootloader
                &none             &bt BT_SEL 0        &bt BT_SEL 1        &bt BT_SEL 2        &bt BT_SEL 3        &bt BT_SEL 4
                &studio_unlock    &none               &none               &none               &none               &none
                &none             &none               &none               &none               &none               &none
                &none             &none               &none               &none               &none               &none
                &none             &none               &none               &none               &none               &none
            >;
        };
        GAME_FN {
            label = "GAME_FN";
            display-name = "GAME_FN";
            /*
             * Auxiliary gaming utility layer over GAME. Numbers 1-0 on top row,
             * F1-F10 on home row, common gaming punctuation on bottom row.
             * Deliberate exit to BASE on RH2; other positions fall through (&trans) to GAME.
             */
            bindings = <
                &trans           &kp NUMBER_1       &kp NUMBER_2        &kp NUMBER_3        &kp NUMBER_4        &kp NUMBER_5
                &kp NUMBER_6     &kp NUMBER_7       &kp NUMBER_8        &kp NUMBER_9        &kp NUMBER_0        &trans
                &trans           &kp F1             &kp F2              &kp F3              &kp F4              &kp F5
                &kp F6           &kp F7             &kp F8              &kp F9              &kp F10             &trans
                &trans           &kp GRAVE          &kp MINUS           &kp EQUAL           &kp LEFT_BRACKET    &kp RIGHT_BRACKET
                &trans           &trans             &trans              &trans              &trans              &trans
                &trans           &trans             &trans              &trans              &trans              &to L_BASE
            >;
        };
    };
};
