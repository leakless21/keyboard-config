#define ZMK_POINTING_DEFAULT_MOVE_VAL 800
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <zmk-helpers/key-labels/sofle.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* Layer numbers are part of the persisted ZMK keymap state. */
#define L_BASE 0
#define L_NAV 1
#define L_MOUSE 2
#define L_MEDIA 3
#define L_NUM 4
#define L_SYM 5
#define L_FUN 6
#define L_HOST 7
#define L_GAME 8
#define L_ADJUST 9

&sk {
    release-after-ms = <1000>;
    quick-release;
    lazy;
    ignore-modifiers;
};

&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&lt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
    quick-tap-ms = <180>;
};

/ {
    behaviors {
        hml: home_row_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                KEYS_R
                THUMBS_R
                RN0 RN1 RN2 RN3 RN4 RN5
                REC
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <
                KEYS_L
                THUMBS_L
                LN0 LN1 LN2 LN3 LN4 LN5
                LEC
            >;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        /*
         * Dedicated HOST thumb layer-tap. Deliberately no quick-tap or
         * require-prior-idle: HOST must engage reliably immediately after
         * ordinary typing.
         */
        host_lt: host_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
        /*
         * Dedicated one-shot sticky modifier for utility modifier rails
         * (NUM, SYM, FUN). Deliberately NO quick-release so sticky modifiers
         * can chain reliably in Callum/Seniply-style usage.
         */
        skm: sticky_modifier {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <1000>;
            lazy;
            ignore-modifiers;
        };
    };

    combos {
        compatible = "zmk,combos";
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust {
            if-layers = <L_NAV L_NUM>;
            then-layer = <L_ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            label = "BASE";
            display-name = "BASE";
            /* Colemak-DH, bilateral HRM, dedicated number row, rotary encoders, and 6-layer thumb model. */
            bindings = <
&kp GRAVE   &kp N1             &kp N2             &kp N3             &kp N4              &kp N5                                         &kp N6              &kp N7              &kp N8             &kp N9             &kp N0             &kp DELETE
&kp ESCAPE  &kp Q              &kp W              &kp F              &kp P               &kp B                                          &kp J               &kp L               &kp U              &kp Y              &kp SQT            &kp BACKSPACE
&mo L_MEDIA &hml LMETA A       &hml LEFT_ALT R    &hml LCTRL S       &hml LEFT_SHIFT T   &kp G                                          &kp M               &hmr RIGHT_SHIFT N  &hmr RCTRL E       &hmr RIGHT_ALT I   &hmr RIGHT_GUI O   &kp SEMICOLON
&sk LSHFT   &kp Z              &kp X              &kp C              &kp D               &kp V       &caps_word          &kp C_MUTE     &kp K               &kp H               &kp COMMA          &kp DOT            &kp SLASH          &kp RIGHT_SHIFT
                               &kp LGUI           &kp LALT           &lt L_MOUSE ESCAPE  &lt L_NAV SPACE &host_lt L_HOST TAB &lt L_SYM ENTER &lt L_NUM BACKSPACE &lt L_FUN DELETE &kp RALT           &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NAV {
            label = "NAV";
            display-name = "NAV";
            /*
             * Right-hand navigation mirrors MOUSE and MEDIA with NEIO geometry.
             * Left-hand carries Seniply/Selenium-inspired everyday application controls:
             * Top row: tab management (PrevTab, NextTab, NewTab, CloseTab, ReopenTab).
             * Home row: primary operations (SelectAll, Save) and held modifiers (GUI, Alt, Ctrl, Shift).
             * Bottom row: secondary navigation (Find, WordLeft, WordRight, FindNext).
             * Functional-layer thumbs are explicit. LT5 provides same-side left bootloader shortcut.
             * Semantic F21-F24 editing signals and Hyper+F13-F24 application signals
             * are interpreted by host bridges.
             */
            bindings = <
&trans       &none                     &none                     &none                     &none                     &none                                          &none                     &none               &none              &none              &none              &trans
&bootloader  &kp LC(LA(LS(LG(F16))))   &kp LC(LA(LS(LG(F17))))   &kp LC(LA(LS(LG(F18))))   &kp LC(LA(LS(LG(F19))))   &kp LC(LA(LS(LG(F20))))                        &kp F24                   &kp F22             &kp F21            &kp F23            &kp LC(LA(LS(LG(F24)))) &none
&kp LC(LA(LS(LG(F13)))) &kp LGUI       &kp LALT                  &kp LCTRL                 &kp LEFT_SHIFT            &kp LC(LA(LS(LG(F14))))                        &caps_word                &kp LEFT            &kp DOWN           &kp UP             &kp RIGHT          &none
&kp LC(LA(LS(LG(F15)))) &kp LC(LA(LS(LG(F21)))) &kp LC(LA(LS(LG(F22)))) &kp LC(LA(LS(LG(F23)))) &none            &none       &trans              &trans         &kp INSERT                &kp HOME            &kp PAGE_DOWN      &kp PAGE_UP        &kp END            &none
                                       &trans                    &trans                    &kp ESCAPE                &none       &kp TAB             &kp ENTER      &kp BACKSPACE             &kp DELETE          &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        MOUSE {
            label = "MOUSE";
            display-name = "MOUSE";
            /* NAV geometry: pointer on home, wheel on secondary bank, F21-F24 editing. */
            bindings = <
&trans       &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&none        &none             &none              &none              &none               &none                                          &kp F24             &kp F22             &kp F21            &kp F23            &kp LC(LA(LS(LG(F24)))) &none
&none        &kp LGUI          &kp LALT           &kp LCTRL          &kp LEFT_SHIFT      &none                                          &mkp MB4            &mmv MOVE_LEFT      &mmv MOVE_DOWN     &mmv MOVE_UP       &mmv MOVE_RIGHT    &mkp MB5
&none        &none             &none              &none              &none               &none       &trans              &trans         &none               &msc SCRL_LEFT      &msc SCRL_DOWN     &msc SCRL_UP       &msc SCRL_RIGHT    &none
                               &trans             &trans             &none               &none       &none               &mkp MB2       &mkp MB1            &mkp MB3            &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>,
                <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        MEDIA {
            label = "MEDIA";
            display-name = "MEDIA";
            /* Directional media controls share NAV's right-hand geometry using Consumer HID. */
            bindings = <
&trans       &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&none        &none             &none              &none              &none               &none                                          &none               &none               &kp C_BRI_DN       &kp C_BRI_UP       &none              &none
&none        &kp LGUI          &kp LALT           &kp LCTRL          &kp LEFT_SHIFT      &none                                          &none               &kp C_PREVIOUS      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP    &kp C_NEXT         &none
&none        &none             &none              &none              &none               &none       &trans              &trans         &none               &none               &none              &none              &none              &none
                               &trans             &trans             &none               &none       &none               &kp C_STOP     &kp C_PLAY_PAUSE    &kp C_MUTE          &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_PREVIOUS C_NEXT>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUM {
            label = "NUM";
            display-name = "NUM";
            /*
             * Spatial numpad with arithmetic operator rail on the outer column;
             * mirrored one-shot modifiers (&skm) on the right.
             * RT5 provides same-side right bootloader shortcut while holding NUM.
             */
            bindings = <
&trans       &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&kp SLASH    &kp LEFT_BRACKET  &kp NUMBER_7       &kp NUMBER_8       &kp NUMBER_9        &kp RIGHT_BRACKET                              &none               &none               &none              &none              &none              &bootloader
&kp ASTERISK &kp SEMICOLON     &kp NUMBER_4       &kp NUMBER_5       &kp NUMBER_6        &kp EQUAL                                      &none               &skm RIGHT_SHIFT    &skm RCTRL         &skm RIGHT_ALT     &skm RIGHT_GUI     &none
&kp PLUS     &kp GRAVE         &kp NUMBER_1       &kp NUMBER_2       &kp NUMBER_3        &kp BACKSLASH &trans              &trans       &none               &none               &none              &none              &none              &none
                               &trans             &trans             &kp PERIOD          &kp NUMBER_0 &kp MINUS           &none        &none               &none               &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        SYM {
            label = "SYM";
            display-name = "SYM";
            /*
             * Seniply+-inspired symbol layer:
             * paired delimiters, comparison/operators on strong positions,
             * programming sigils, and mirrored one-shot modifiers (&skm).
             */
            bindings = <
&trans          &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&kp AT_SIGN     &kp HASH          &kp DOLLAR         &kp RIGHT_BRACKET  &kp RIGHT_BRACE     &kp RIGHT_PARENTHESIS                          &none               &none               &none              &none              &none              &none
&kp EXCLAMATION &kp LESS_THAN     &kp GREATER_THAN   &kp LEFT_BRACKET   &kp LEFT_BRACE      &kp LEFT_PARENTHESIS                           &none               &skm RIGHT_SHIFT    &skm RCTRL         &skm RIGHT_ALT     &skm RIGHT_GUI     &none
&kp AMPERSAND   &kp PIPE          &kp ASTERISK       &kp MINUS          &kp EQUAL           &kp PLUS      &trans              &trans       &none               &none               &none              &none              &none              &none
                                  &trans             &trans             &kp BACKSLASH       &kp SLASH     &kp UNDERSCORE      &none        &none               &none               &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        FUN {
            label = "FUN";
            display-name = "FUN";
            /* F-key geometry mirrors NUM; the right hand carries one-shot modifiers (&skm). */
            bindings = <
&trans       &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&none        &kp F12           &kp F7             &kp F8             &kp F9              &kp PRINTSCREEN                                &kp CAPSLOCK        &none               &none              &none              &none              &none
&none        &kp F11           &kp F4             &kp F5             &kp F6              &kp SCROLLLOCK                                 &none               &skm RIGHT_SHIFT    &skm RCTRL         &skm RIGHT_ALT     &skm RIGHT_GUI     &none
&none        &kp F10           &kp F1             &kp F2             &kp F3              &kp PAUSE_BREAK &trans          &trans         &none               &none               &none              &none              &none              &none
                               &trans             &trans             &kp K_APP           &kp SPACE   &kp TAB             &none          &none               &none               &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        HOST {
            label = "HOST";
            display-name = "HOST";
            /*
             * Semantic F-key protocol arranged by frequency: home row visits
             * workspaces, top row mirrors it one row up to move a window
             * there. Left bottom row holds system and terminal launchers.
             * Right home row has Previous Window and directional focus;
             * right bottom row has directional move. Right top row has
             * modal controls (Resize, Service) and Esc. Right thumbs carry
             * context actions (Fullscreen, Previous WS, Float).
             */
            bindings = <
&trans       &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &trans
&none        &kp LS(F13)       &kp LS(F14)        &kp LS(F15)        &kp LS(F16)         &kp LS(F17)                                    &none               &kp LS(F18)         &kp LA(F18)        &none              &none              &kp ESCAPE
&none        &kp F13           &kp F14            &kp F15            &kp F16             &kp F17                                        &kp LA(F16)         &kp LC(F13)         &kp LC(F14)        &kp LC(F15)        &kp LC(F16)        &none
&none        &kp LA(F13)       &kp LA(F14)        &kp LA(F15)        &kp LA(F17)         &none       &trans              &trans         &none               &kp LC(LS(F13))     &kp LC(LS(F14))    &kp LC(LS(F15))    &kp LC(LS(F16))    &none
                               &trans             &trans             &none               &none       &none               &kp F19        &kp F18             &kp F20             &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        GAME {
            label = "GAME";
            display-name = "GAME";
            /*
             * Single complete gaming layout on plain QWERTY.
             * Physical number row, direct modifiers, no HRMs, no sticky keys.
             * Deliberate exit to BASE via right encoder press (REC).
             */
            bindings = <
&kp GRAVE    &kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3       &kp NUMBER_4        &kp NUMBER_5                                   &kp NUMBER_6        &kp NUMBER_7        &kp NUMBER_8       &kp NUMBER_9       &kp NUMBER_0       &kp DELETE
&kp ESCAPE   &kp Q             &kp W              &kp E              &kp R               &kp T                                          &kp Y               &kp U               &kp I              &kp O              &kp P              &kp BACKSPACE
&kp TAB      &kp A             &kp S              &kp D              &kp F               &kp G                                          &kp H               &kp J               &kp K              &kp L              &kp SEMICOLON      &kp SQT
&kp LEFT_SHIFT &kp Z           &kp X              &kp C              &kp V               &kp B       &none               &to L_BASE     &kp N               &kp M               &kp COMMA          &kp DOT            &kp SLASH          &kp RIGHT_SHIFT
                               &kp LCTRL          &kp LALT           &kp SPACE           &kp SPACE   &kp TAB             &kp ENTER      &kp BACKSPACE       &kp DELETE          &kp RALT           &kp RGUI
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        ADJUST {
            label = "ADJUST";
            display-name = "ADJUST";
            /*
             * NAV + NUM only. Device management is explicit and source-local.
             * GAME is entered here deliberately, not from ordinary NAV keys.
             */
            bindings = <
&none        &none             &none              &none              &none               &none                                          &none               &none               &none              &none              &none              &none
&bootloader  &sys_reset        &bt BT_CLR         &out OUT_USB       &out OUT_BLE        &ext_power EP_ON                               &ext_power EP_OFF   &bt BT_NXT          &bt BT_PRV         &to L_GAME         &sys_reset         &bootloader
&none        &bt BT_SEL 0      &bt BT_SEL 1       &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_SEL 4                                   &studio_unlock      &none               &none              &none              &none              &none
&none        &none             &none              &none              &none               &none       &trans              &trans         &none               &none               &none              &none              &none              &none
                               &trans             &trans             &none               &none       &none               &none          &none               &none               &trans             &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PAGE_DOWN PAGE_UP>,
                <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };
    };
};
