# Canonical Ghostty terminal configuration for semantic keyboard / AeroSpace workflow.
# Install this file at ~/.config/ghostty/config; see docs/hosts/macos.md.

# Theme and transparency
theme = Catppuccin Mocha
background = #161616
background-opacity = 0.8
background-blur = true
background-blur-radius = 20

# Quick Terminal (dropdown/scratch terminal)
# Global toggle shortcut: Ctrl+`
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# Quick Terminal appearance & behavior
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0
quick-terminal-autohide = true
