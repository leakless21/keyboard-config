{
  "title": "Keyboard Semantic Host Bridge - External (Desktop Launchers, Hyper+F13-F24 Application Actions, F21-F24 Editing, Standard F1-F12 Normalization)",
  "rules": [
    {
      "description": "Semantic Desktop Actions & Launchers (Alt+F13 Spotlight, Alt+F15 New Terminal, Alt+F17 Language)",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": false
                }
              ]
            }
          ],
          "from": {
            "key_code": "f13",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [
                "left_command"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": false
                }
              ]
            }
          ],
          "from": {
            "key_code": "f15",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "shell_command": "osascript -e 'tell application \"Ghostty\" to activate' -e 'tell application \"Ghostty\" to new window'"
            }
          ]
        },
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": false
                }
              ]
            }
          ],
          "from": {
            "key_code": "f17",
            "modifiers": {
              "mandatory": [
                "option"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "key_code": "spacebar",
              "modifiers": [
                "left_control"
              ]
            }
          ]
        }
      ]
    },
