{
  "title": "MacBook Built-in Keyboard OmniWM Adapter",
  "rules": [
    {
      "description": "MacBook Built-in Keyboard OmniWM Navigation & Window Management",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "1",
            "modifiers": {
              "mandatory": [
                "option",
                "shift"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/Applications/OmniWM.app/Contents/MacOS/omniwmctl command move-to-workspace 1"
            }
          ]
        },
        {
          "type": "basic",
