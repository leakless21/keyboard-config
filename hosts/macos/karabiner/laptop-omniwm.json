{
  "title": "MacBook Built-in Keyboard OmniWM Adapter",
  "rules": [
    {
      "description": "MacBook Built-in Keyboard OmniWM Navigation & Window Management",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "device_if",
              "identifiers": [
                {
                  "is_built_in_keyboard": true
                }
              ]
            }
          ],
          "from": {
            "key_code": "left_option",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "omniwm_option_held",
                "value": 1
              }
            },
            {
              "key_code": "left_option"
            }
          ],
          "to_after_key_up": [
            {
              "set_variable": {
                "name": "omniwm_option_held",
                "value": 0
              }
            }
          ]
        },
        {
          "type": "basic",
